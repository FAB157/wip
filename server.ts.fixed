      "tabella_budget": { "attrazioni": {"dettaglio":"", "stima_pp": ""}, "trasporti": {"dettaglio":"", "stima_pp": ""}, "colazione": {"dettaglio":"", "stima_pp": ""}, "pranzo": {"dettaglio":"", "stima_pp": ""}, "cena": {"dettaglio":"", "stima_pp": ""}, "totale_giorno": "" }
    }
  ],
  "totale_viaggio": "Prezzo"
}
