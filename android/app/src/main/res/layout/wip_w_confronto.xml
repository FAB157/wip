<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «Confronto opere» (23/09/2026): due opere ascoltate oggi, un tocco
     sulla preferita salva il voto (solo in locale, nell'app). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_co_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/wip_widget_bg"
    android:padding="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_co_titolo" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:singleLine="true" android:textColor="#B8FFFFFF" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_co_museo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp"
            android:gravity="end" android:singleLine="true" android:ellipsize="end" android:textColor="#80FFFFFF" android:textSize="9sp" />
    </LinearLayout>

    <TextView android:id="@+id/w_co_vuoto" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:textColor="#B8FFFFFF" android:textSize="12sp" android:textStyle="bold" android:visibility="gone" />

    <LinearLayout android:id="@+id/w_co_corpo" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:layout_marginTop="2dp">
        <TextView android:id="@+id/w_co_domanda" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end"
            android:gravity="center" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
            <LinearLayout android:id="@+id/w_co_a" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/w_co_a_foto" android:layout_width="72dp" android:layout_height="72dp" android:scaleType="centerCrop"
                    android:background="@drawable/wip_w_riquadro" android:contentDescription="@null" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
                    <TextView android:id="@+id/w_co_a_nome" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end"
                        android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/w_co_a_autore" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end"
                        android:textColor="#B8FFFFFF" android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginEnd="4dp"
                android:text="@string/wip_w_contro" android:textColor="#D4AF37" android:textSize="10sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/w_co_b" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/w_co_b_foto" android:layout_width="72dp" android:layout_height="72dp" android:scaleType="centerCrop"
                    android:background="@drawable/wip_w_riquadro" android:contentDescription="@null" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
                    <TextView android:id="@+id/w_co_b_nome" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end"
                        android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/w_co_b_autore" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end"
                        android:textColor="#B8FFFFFF" android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
