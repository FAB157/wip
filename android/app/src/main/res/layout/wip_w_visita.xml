<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «Continua la visita» (14/09/2026): museo, opere ascoltate, prossima opera. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_vi_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/wip_widget_bg"
    android:padding="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_vi_titolo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:singleLine="true" android:ellipsize="end" android:textColor="#B8FFFFFF" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_vi_conta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#80FFFFFF" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>

    <TextView android:id="@+id/w_vi_vuoto" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:textColor="#B8FFFFFF" android:textSize="12sp" android:textStyle="bold" android:visibility="gone" />

    <LinearLayout android:id="@+id/w_vi_corpo" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:layout_marginTop="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/w_vi_foto" android:layout_width="52dp" android:layout_height="52dp" android:scaleType="centerCrop"
                android:background="@drawable/wip_w_riquadro" android:contentDescription="@null" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                <TextView android:id="@+id/w_vi_museo" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/w_vi_prossima" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textColor="#B8FFFFFF" android:textSize="11sp" />
                <TextView android:id="@+id/w_vi_sala" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="#80FFFFFF" android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
        <ProgressBar android:id="@+id/w_vi_barra" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp"
            android:layout_marginTop="8dp" android:progressTint="#D4AF37" android:progressBackgroundTint="#33FFFFFF" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
            <TextView android:id="@+id/w_vi_ascoltate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#80FFFFFF" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_vi_tasto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/wip_w_pillola"
                android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:textColor="#1E3A8A" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
