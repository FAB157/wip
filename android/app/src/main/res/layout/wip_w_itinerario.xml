<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «Itinerario di oggi» (14/09/2026): prossima tappa + 3 seguenti. Solo view RemoteViews. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_it_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/wip_widget_bg"
    android:padding="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_it_titolo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:singleLine="true" android:ellipsize="end" android:textColor="#B8FFFFFF" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_it_conta" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#80FFFFFF" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>

    <TextView android:id="@+id/w_it_vuoto" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:textColor="#B8FFFFFF" android:textSize="12sp" android:textStyle="bold" android:visibility="gone" />

    <LinearLayout android:id="@+id/w_it_corpo" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:layout_marginTop="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/w_it_icona" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center"
                android:background="@drawable/wip_w_riquadro" android:textSize="20sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                <TextView android:id="@+id/w_it_etichetta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#D4AF37" android:textSize="9sp" android:textStyle="bold" />
                <TextView android:id="@+id/w_it_nome" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/w_it_dettagli" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="#B8FFFFFF" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/w_it_r1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
            <TextView android:id="@+id/w_it_r1_ora" android:layout_width="36dp" android:layout_height="wrap_content" android:textColor="#80FFFFFF" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_it_r1_nome" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:singleLine="true" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_it_r2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="3dp">
            <TextView android:id="@+id/w_it_r2_ora" android:layout_width="36dp" android:layout_height="wrap_content" android:textColor="#80FFFFFF" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_it_r2_nome" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:singleLine="true" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_it_r3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="3dp">
            <TextView android:id="@+id/w_it_r3_ora" android:layout_width="36dp" android:layout_height="wrap_content" android:textColor="#80FFFFFF" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_it_r3_nome" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:singleLine="true" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
