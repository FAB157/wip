<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «Ripeti in un'altra lingua» (23/09/2026): l'ultima audioguida e un
     tasto «Ascolta in <lingua>». Solo testi gia' in cache: nessuna generazione. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_li_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/wip_widget_bg"
    android:padding="12dp">

    <TextView android:id="@+id/w_li_titolo" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:singleLine="true" android:ellipsize="end" android:textColor="#B8FFFFFF" android:textSize="10sp" android:textStyle="bold" />

    <TextView android:id="@+id/w_li_vuoto" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:textColor="#B8FFFFFF" android:textSize="12sp" android:textStyle="bold" android:visibility="gone" />

    <LinearLayout android:id="@+id/w_li_corpo" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:layout_marginTop="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/w_li_foto" android:layout_width="44dp" android:layout_height="44dp" android:scaleType="centerCrop"
                android:background="@drawable/wip_w_riquadro" android:contentDescription="@null" />
            <TextView android:id="@+id/w_li_nome" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp"
                android:maxLines="2" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom">
            <TextView android:id="@+id/w_li_nota" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end"
                android:textColor="#B8FFFFFF" android:textSize="9sp" android:visibility="gone" />
            <TextView android:id="@+id/w_li_tasto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/wip_w_pillola"
                android:layout_marginTop="4dp" android:singleLine="true" android:ellipsize="end" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="3dp" android:paddingBottom="3dp"
                android:textColor="#1E3A8A" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
