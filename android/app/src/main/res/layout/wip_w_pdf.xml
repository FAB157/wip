<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «Guida stampata» (23/09/2026): l'ultimo PDF dell'archivio, da
     riaprire o condividere (lo fa l'app, dal suo archivio locale). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_pd_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/wip_widget_bg"
    android:padding="12dp">

    <TextView android:id="@+id/w_pd_titolo" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:singleLine="true" android:ellipsize="end" android:textColor="#B8FFFFFF" android:textSize="10sp" android:textStyle="bold" />

    <TextView android:id="@+id/w_pd_vuoto" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:textColor="#B8FFFFFF" android:textSize="12sp" android:textStyle="bold" android:visibility="gone" />

    <LinearLayout android:id="@+id/w_pd_corpo" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:layout_marginTop="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/w_pd_icona" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center"
                android:background="@drawable/wip_w_riquadro" android:text="@string/wip_w_documento" android:textSize="22sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                <TextView android:id="@+id/w_pd_nome" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end"
                    android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/w_pd_quando" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end"
                    android:textColor="#80FFFFFF" android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="bottom|end">
            <TextView android:id="@+id/w_pd_condividi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/wip_w_pillola"
                android:layout_marginEnd="6dp" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="3dp" android:paddingBottom="3dp"
                android:textColor="#1E3A8A" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_pd_apri" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/wip_w_pillola"
                android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="3dp" android:paddingBottom="3dp"
                android:textColor="#1E3A8A" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
