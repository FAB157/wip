<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «Crediti e Pass» (14/09/2026): saldo, Day Pass con scadenza. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_cr_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/wip_widget_bg"
    android:padding="12dp">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wip_w_marchio"
        android:textColor="#B8FFFFFF" android:textSize="10sp" android:textStyle="bold" />

    <TextView android:id="@+id/w_cr_vuoto" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:textColor="#B8FFFFFF" android:textSize="12sp" android:textStyle="bold" android:visibility="gone" />

    <LinearLayout android:id="@+id/w_cr_corpo" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:layout_marginTop="4dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
            <TextView android:id="@+id/w_cr_saldo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_cr_unita" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:layout_marginBottom="6dp" android:textColor="#B8FFFFFF" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_cr_pass" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/wip_w_pillola" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:layout_marginTop="6dp">
            <TextView android:id="@+id/w_cr_pass_titolo" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="#1E3A8A" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_cr_pass_dettaglio" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="#1E3A8A" android:textSize="9sp" />
        </LinearLayout>
        <TextView android:id="@+id/w_cr_apri" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#80FFFFFF" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
