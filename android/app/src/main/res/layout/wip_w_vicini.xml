            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/wip_w_cuffie" android:textColor="#D4AF37" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/w_vc_r5" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
