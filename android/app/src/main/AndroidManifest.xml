<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name="androidx.multidex.MultiDexApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="itainta" android:host="poi" />
            </intent-filter>

            <!-- App Link (Android 6+) per i link di conferma email / reset password
                 inviati da Supabase Auth, che puntano a https://wip.guide/auth/callback
                 (vedi LoginScreen.tsx confirmRedirect / resetPasswordForEmail). Con
                 autoVerify="true" + assetlinks.json pubblicato su wip.guide/.well-known/,
                 Android apre l'app direttamente invece del browser, saltando il passaggio
                 manuale "torna nell'app e rifai login".
                 Scope volutamente limitato a /auth/*: NON copre la root (usata anche da
                 ?pin=/?groupplan=) né /privacy, /support, /terms, /delete-account, che
                 restano link normali aperti dal browser di sistema.
                 ATTENZIONE: autoVerify funziona solo se assetlinks.json è raggiungibile
                 su https://wip.guide/.well-known/assetlinks.json con lo SHA-256 reale
                 del certificato di firma (vedi public/.well-known/assetlinks.json:
                 oggi contiene solo un placeholder). Finché non è pubblicato con
                 l'impronta vera, Android NON verifica il dominio e questo intent-filter
                 resta silenzioso (il link continuerà ad aprirsi nel browser). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="wip.guide"
                    android:pathPrefix="/auth" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <service
            android:name=".WipBackgroundAudioService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Old ItaIntaService removed — replaced by ItaintaBackgroundPoiService -->

        <service
            android:name="com.equimaps.capacitor_background_geolocation.BackgroundGeolocationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location"
            tools:replace="android:exported" />
        <service
            android:name=".service.ItaintaBackgroundPoiService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- Android Auto (sperimentale): app template-based, categoria POI.
             L'host dell'auto si collega a WipCarAppService e renderizza il radar. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />
        <service
            android:name=".car.WipCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.POI" />
            </intent-filter>
        </service>

        <receiver
            android:name=".geofence.GeofenceBroadcastReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.ServiceWatchdog"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".geofence.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- SCHEDULE_EXACT_ALARM / USE_FULL_SCREEN_INTENT / DISABLE_KEYGUARD rimossi
         per policy Play (ago 2026): il watchdog usa già il fallback inesatto e
         l'arrivo al POI è una notifica heads-up, come su iOS. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
