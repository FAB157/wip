{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-revenuecat-agp9.mjs",
    "dev": "tsx server.ts",
    "fix": "node final_rescue.cjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist-server/server.cjs",
    "start": "node dist-server/server.cjs",
    "sync:native": "npm run build && npx cap sync && node scripts/pulisci-asset-nativi.mjs",
    "capacitor:copy:after": "node scripts/pulisci-asset-nativi.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server",
    "lint": "tsc --noEmit",
    "check-brackets": "node scratch/check_brackets.js",
    "deploy": "vercel --prod --yes && node scripts/smoke-deploy.mjs",
    "smoke": "node scripts/smoke-deploy.mjs",
    "generate-assets": "capacitor-assets generate --android --ios --iconBackgroundColor '#1e3a8a' --iconBackgroundColorDark '#1e3a8a' --splashBackgroundColor '#1e3a8a' --splashBackgroundColorDark '#1e3a8a'",
    "repair-carrara": "node scripts/repair_cararra_poi.js",
    "enrich": "npx tsx scripts/mass_enrich_background.ts",
    "enrich-bg": "npx tsx scripts/mass_enrich_background.ts",
    "fix-photos": "npx tsx scripts/fix_poi_photos.ts",
    "test:data": "npx tsx scripts/tests/taxonomy.test.ts && npx tsx scripts/tests/wiki.test.ts",
    "test-google-tts": "node scratch/test_google_tts.cjs"
  },
  "dependencies": {
    "@capacitor-community/native-audio": "^8.0.0",
    "@capacitor/android": "^7.6.6",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/geolocation": "^7.0.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^7.6.8",
    "@capacitor/local-notifications": "^7.0.6",
    "@capacitor/network": "^7.0.0",
    "@capacitor/preferences": "^8.0.1",
    "@capgo/capacitor-native-biometric": "^6.0.0",
    "@google/genai": "^1.29.0",
    "@revenuecat/purchases-capacitor": "^11.3.2",
    "@stripe/stripe-js": "^9.6.0",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.100.14",
    "@turf/turf": "^7.3.5",
    "@types/html2pdf.js": "^0.10.0",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "archiver": "^8.0.0",
    "axios": "^1.16.1",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "dotenv": "^17.2.3",
    "expo": "^56.0.8",
    "express": "^4.21.2",
    "groq-sdk": "^1.2.0",
    "html2pdf.js": "^0.10.3",
    "i18n-iso-countries": "^7.14.0",
    "idb-keyval": "^6.2.2",
    "leaflet": "^1.9.4",
    "leaflet-rotate": "^0.2.8",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-ssh": "^13.2.1",
    "openai": "^6.44.0",
    "pg": "^8.21.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "react-swipeable": "^7.0.2",
    "ssh2": "^1.17.0",
    "stripe": "^22.1.1",
    "tz-lookup": "^6.1.25",
    "vite": "^6.2.3",
    "which-country": "^1.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
