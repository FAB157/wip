<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>it</string>
	<key>CFBundleDisplayName</key>
	<string>WIP</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.itaintasca.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>itainta</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>comgooglemaps</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Documenti dell'app visibili nell'app File (Sull'iPhone → WIP):
	     senza queste chiavi le foto Vision salvate in Documenti/WIP Vision
	     esistevano ma l'utente non poteva trovarle da nessuna parte. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>WIP richiede l'accesso alla tua posizione sempre per rilevare monumenti e Gemme vicine mentre cammini o guidi, avvisandoti con l'audioguida anche se il telefono è in tasca o l'app è chiusa. La posizione non viene usata per pubblicità.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>La tua posizione serve per mostrarti i punti di interesse sulla mappa e calcolare il percorso verso i monumenti.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>L'accesso continuo alla posizione permette all'audioguida di attivarsi automaticamente mentre esplori la città, anche a schermo spento.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Utilizziamo il Face ID per proteggere il tuo profilo e i tuoi contenuti premium.</string>
	<key>NSCameraUsageDescription</key>
	<string>La fotocamera serve per la funzione Vision che riconosce i monumenti inquadrati.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Il microfono potrebbe essere usato per i comandi vocali della guida.</string>
	<!-- Solo i background mode realmente implementati: 'fetch' e
	     'remote-notification' erano dichiarati senza handler né entitlement
	     push — in App Review sono solo domande in più. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
