<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lingua di sviluppo: 'en', allineata a developmentRegion nel pbxproj e al
	     fallback lingua del codice. Le stringhe italiane restano nelle
	     InfoPlist.strings di it.lproj; en.lproj porta la traduzione inglese. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<!-- Lingue effettivamente supportate dall'app (i18n a 7 lingue): senza questo
	     elenco App Store mostra la sola lingua di sviluppo. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>it</string>
		<string>en</string>
		<string>fr</string>
		<string>es</string>
		<string>de</string>
		<string>ru</string>
		<string>zh-Hans</string>
	</array>
	<!-- L'app usa solo HTTPS standard: nessuna crittografia non esente. Senza
	     questa chiave ogni submission si ferma a chiedere la dichiarazione export. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleDisplayName</key>
	<string>WIP</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.itaintasca.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>itainta</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>comgooglemaps</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Documenti dell'app visibili nell'app File (Sull'iPhone → WIP):
	     senza queste chiavi le foto Vision salvate in Documenti/WIP Vision
	     esistevano ma l'utente non poteva trovarle da nessuna parte. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>WIP richiede l'accesso alla tua posizione sempre per rilevare monumenti e Gemme vicine mentre cammini o guidi, avvisandoti con l'audioguida anche se il telefono è in tasca o l'app è chiusa. La posizione non viene usata per pubblicità.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>La tua posizione serve per mostrarti i punti di interesse sulla mappa e calcolare il percorso verso i monumenti.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>L'accesso continuo alla posizione permette all'audioguida di attivarsi automaticamente mentre esplori la città, anche a schermo spento.</string>
	<!-- Precisione piena temporanea (MAP-08): con «Posizione esatta» spenta iOS
	     consegna fix a ~3 km e nessun trigger a 30 m può scattare. La chiave
	     `Audioguida` è quella passata da BackgroundPoiManager a
	     requestTemporaryFullAccuracyAuthorization(withPurposeKey:). -->
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>Audioguida</key>
		<string>Serve la posizione precisa per riconoscere il monumento davanti a te</string>
	</dict>
	<key>NSFaceIDUsageDescription</key>
	<string>Utilizziamo il Face ID per proteggere il tuo profilo e i tuoi contenuti premium.</string>
	<key>NSCameraUsageDescription</key>
	<string>La fotocamera serve per la funzione Vision che riconosce i monumenti inquadrati.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Il microfono è usato per dettare a voce le domande alla guida AI durante l'ascolto delle audioguide.</string>
	<!-- Gating sensori anti-teletrasporto GPS (MotionActivityGate.swift):
	     se l'utente nega il permesso il comportamento resta identico a prima
	     (fail-safe, nessuna soppressione dei trigger). -->
	<key>NSMotionUsageDescription</key>
	<string>I dati di movimento (fermo, camminata, veicolo) servono solo a evitare falsi avvisi dell'audioguida quando il segnale GPS salta mentre sei fermo. Non vengono condivisi né usati per pubblicità.</string>
	<!-- Solo i background mode realmente implementati: 'remote-notification'
	     era dichiarato senza entitlement push — in App Review è solo una
	     domanda in più. 'fetch' invece ORA ha un handler reale (vedi
	     BGTaskSchedulerPermittedIdentifiers sotto e AppDelegate.swift,
	     registerOfflineRefreshTask/scheduleOfflineRefresh): richiesto da
	     BGAppRefreshTaskRequest, non solo dal vecchio
	     performFetchWithCompletionHandler (mai usato qui). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
		<string>fetch</string>
	</array>
	<!-- Refresh opportunistico dei pacchetti offline (WipPackageDownloadManager):
	     ogni identifier che AppDelegate passa a BGTaskScheduler.register/submit
	     deve comparire qui, altrimenti la registrazione/submit fallisce in
	     silenzio (nessun crash, ma l'OS non risveglierà mai l'app). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.itaintasca.app.offline-refresh</string>
	</array>
	<!-- Live Activity del navigatore (28/08/2026): il cruscotto del giro sulla
	     lock screen e nella Dynamic Island (WipNavActivity). Senza questa
	     chiave ActivityKit rifiuta ogni richiesta e Activity.request lancia
	     `unsupported`. Vedi LiveActivityNav.swift. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Aggiornamenti frequenti dalla stessa app in foreground/background
	     (a ogni cambio di svolta): senza, iOS puo` limitare le update. -->
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
