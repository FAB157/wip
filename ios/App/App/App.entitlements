<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Group condiviso con l'estensione WipNavActivity: e' dove l'app
	     scrive la foto della tappa e la Live Activity la legge
	     (WipNavAppGroup.id in WipNavAttributes.swift). Lo stesso identificatore
	     va abilitato sull'App ID nel portale sviluppatori Apple prima della
	     firma; la build NON firmata della CI lo ignora. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.itaintasca.app</string>
	</array>
	<!-- Accedi con Apple NATIVO (09/09/2026): senza questa capability
	     ASAuthorizationAppleIDProvider fallisce subito con errore 1000 e il
	     login ricade sul browser. Come per l'App Group, va abilitata anche
	     sull'App ID nel portale sviluppatori: in CI ci pensa xcodebuild con
	     -allowProvisioningUpdates e la chiave API di App Store Connect. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
