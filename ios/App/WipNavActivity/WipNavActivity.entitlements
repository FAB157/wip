<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Stesso App Group dell'app (App/App.entitlements): senza, la Live
	     Activity non vede la foto della tappa scritta dall'app. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.itaintasca.app</string>
	</array>
</dict>
</plist>
